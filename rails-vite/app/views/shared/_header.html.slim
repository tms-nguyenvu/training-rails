  nav.px-4.lg:px-6
    .max-w-screen-xl.mx-auto.border-b.py-4
      .flex.items-center.justify-between

        a.flex.items-center.shrink-0 href="/"
          img.mr-2.h-8.sm:h-10 src="https://flowbite.com/docs/images/logo.svg" alt="Flowbite Logo"
          span.text-2xl.font-semibold.text-indigo-600.whitespace-nowrap.dark:text-white Bloggen


        = form_with url: posts_path, method: :get, class: "hidden lg:flex lg:items-center lg:space-x-2 flex-grow max-w-md mx-4" do |f|
          = f.search_field :q, placeholder: "Search posts...", class: "block w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-indigo-500 focus:border-indigo-500 shadow-sm transition dark:bg-gray-800 dark:text-white dark:border-gray-600 placeholder-gray-500 text-sm"
          = f.submit "Search", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-sm py-2 px-4 rounded-md shadow transition"

        .flex.items-center.space-x-4.lg:order-2
          - if user_signed_in?
            .relative data-controller="dropdown"
              button#user-menu-button.flex.items-center.space-x-2.text-sm.rounded-full.focus:ring-4.focus:ring-indigo-300.dark:focus:ring-indigo-800.transition type="button" data-action="click->dropdown#toggle"
                img.w-9.h-9.rounded-full.border.border-gray-300.dark:border-gray-600 src="https://i.pravatar.cc/40" alt="User Avatar"

              #user-dropdown.hidden.absolute.z-10.right-0.mt-2.w-52.bg-white.rounded-xl.shadow-lg.dark:bg-gray-700 data-dropdown-target="menu"
                - if current_user.has_role?(:admin)
                  ul.py-2.text-sm.text-gray-700.dark:text-gray-200.border-b.border-gray-200.dark:border-gray-600
                    li
                      = link_to 'Manager Post', admin_posts_path, class: "block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600", data: { turbo_prefetch: false }
                    li
                      = link_to 'Manager Category', admin_categories_path, class: "block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600", data: { turbo_prefetch: false }
                    li
                      = link_to 'Ai Generate Post', admin_categories_path, class: "block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600", data: { turbo_prefetch: false }

                ul.py-2.text-sm.text-gray-700.dark:text-gray-200
                  li
                    = link_to 'Profile', edit_user_registration_path, class: "block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600"
                  li
                    = button_to 'Sign Out', destroy_user_session_path, method: :delete, class: "block w-full text-left px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600"
          - else
            = link_to 'Sign In', new_user_session_path, class: 'text-gray-800 dark:text-white hover:bg-gray-50 dark:hover:bg-gray-700 focus:ring-4 focus:ring-indigo-300 dark:focus:ring-indigo-800 font-medium rounded-lg text-sm px-4 py-2 transition'

    #mobile-menu-2.mt-2.lg:mt-0.max-w-screen-xl.mx-auto.py-1
      ul.flex.flex-col.lg:flex-row.lg:space-x-8.text-sm.font-medium
        li
          a.block.py-2.text-indigo-700.hover:text-indigo-900.dark:text-white.dark:hover:text-indigo-400 href="/" data-turbo-prefetch="false" Home
        li
          = link_to 'Posts', posts_path, class: 'block py-2 text-gray-700 hover:text-indigo-700 dark:text-gray-400 dark:hover:text-white', data: { turbo_prefetch: false }
