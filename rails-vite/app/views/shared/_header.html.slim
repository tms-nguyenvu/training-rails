header
  nav.bg-white.border-gray-200.px-4.lg:px-6.py-4.dark:bg-gray-800
    .flex.flex-wrap.justify-between.items-center.mx-auto.max-w-screen-xl
      / Logo
      a.flex.items-center href="/"
        img.mr-3.h-6.sm:h-9 src="https://flowbite.com/docs/images/logo.svg" alt="Flowbite Logo"
        span.self-center.text-xl.font-semibold.whitespace-nowrap.dark:text-white Bloggen

      / Avatar & Dropdown
      .flex.items-center.lg:order-2
        - if user_signed_in?
          .relative data-controller="dropdown"
            / Avatar Button
            button#user-menu-button.flex.items-center.space-x-2.text-sm.focus:ring-4.focus:ring-gray-300.dark:focus:ring-gray-800 type="button" data-action="click->dropdown#toggle"
              img.w-8.h-8.rounded-full.border.border-gray-300.dark:border-gray-600 src="https://i.pravatar.cc/40" alt="User Avatar"

            / Dropdown Menu
            #user-dropdown.hidden.absolute.z-10.right-0.mt-2.w-48.bg-white.rounded-lg.shadow-lg.dark:bg-gray-700 data-dropdown-target="menu"
              / Admin Menu - Only show if user has admin role
              - if current_user.has_role?(:admin)
                ul.py-2.text-sm.text-gray-700.dark:text-gray-200.border-b.border-gray-200.dark:border-gray-600
                  li
                    = link_to 'Manager Post', admin_posts_path, class: "block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600"
                  li
                    = link_to 'Manager Category', admin_categories_path, class: "block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600"

              / User Menu - Always show for all signed in users
              ul.py-2.text-sm.text-gray-700.dark:text-gray-200
                li
                  = link_to 'Profile', edit_user_registration_path, class: "block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600"
                li
                  = button_to 'Sign Out', destroy_user_session_path, method: :delete, class: "block w-full text-left px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600"

        - else
          = link_to 'Sign In', new_user_session_path, class: 'text-gray-800 dark:text-white hover:bg-gray-50 focus:ring-4 focus:ring-gray-300 font-medium rounded-lg text-sm px-4 py-2 dark:hover:bg-gray-700 focus:outline-none dark:focus:ring-gray-800'

      / Navigation Links
      #mobile-menu-2.hidden.justify-between.items-center.w-full.lg:flex.lg:w-auto.lg:order-1
        ul.flex.flex-col.mt-4.font-medium.lg:flex-row.lg:space-x-8.lg:mt-0
          li
            a.block.py-2.pr-4.pl-3.text-primary-700.lg:p-0.dark:text-white href="/" Home
          li
            = link_to 'Posts', posts_path, class: 'block py-2 pr-4 pl-3 text-gray-700 hover:text-primary-700 lg:p-0 dark:text-gray-400 dark:hover:text-white'
