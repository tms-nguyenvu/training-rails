header
  nav.bg-white.border-gray-200.px-4.lg:px-6.py-2.5.dark:bg-gray-800
    .flex.flex-wrap.justify-between.items-center.mx-auto.max-w-screen-xl
      a.flex.items-center[href="https://flowbite.com"]
        img.mr-3.h-6.sm:h-9[src="https://flowbite.com/docs/images/logo.svg" alt="Flowbite Logo"]
        span.self-center.text-xl.font-semibold.whitespace-nowrap.dark:text-white
          | Flowbite

      .flex.items-center.lg:order-2
        - if user_signed_in?
          
          - if current_user.has_role?(:admin)
            = link_to 'Manager Post', admin_dashboard_path, class: 'text-gray-800 dark:text-white hover:bg-gray-50 focus:ring-4 focus:ring-gray-300 font-medium rounded-lg text-sm px-4 py-2 dark:hover:bg-gray-700 focus:outline-none dark:focus:ring-gray-800'
          
          = button_to 'Log Out', destroy_user_session_path, method: :delete, class: 'text-gray-800 dark:text-white hover:bg-gray-50 focus:ring-4 focus:ring-gray-300 font-medium rounded-lg text-sm px-4 py-2 dark:hover:bg-gray-700 focus:outline-none dark:focus:ring-gray-800'
        - else
          = link_to 'Sign In', new_user_session_path, class: 'text-gray-800 dark:text-white hover:bg-gray-50 focus:ring-4 focus:ring-gray-300 font-medium rounded-lg text-sm px-4 py-2 dark:hover:bg-gray-700 focus:outline-none dark:focus:ring-gray-800'

      #mobile-menu-2.hidden.justify-between.items-center.w-full.lg:flex.lg:w-auto.lg:order-1
        ul.flex.flex-col.mt-4.font-medium.lg:flex-row.lg:space-x-8.lg:mt-0
          li
            a.block.py-2.pr-4.pl-3.text-white.rounded.bg-primary-700.lg:bg-transparent.lg:text-primary-700.lg:p-0.dark:text-white[href="/" aria-current="page"]
              | Home
          li
            = link_to 'Posts', posts_path, class: 'block py-2 pr-4 pl-3 text-gray-700 hover:text-primary-700 lg:p-0 dark:text-gray-400 dark:hover:text-white'
