- comment ||= post.comments.build

= form_with(model: [post, comment], data: { turbo_frame: 'comment_form', controller: 'post-form' }) do |f|
  .form-control
    = f.rich_text_area :content
    = f.submit comment.persisted? ? "Update" : "Reply", class: "mt-6 max-w-2xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-4 rounded-lg shadow-md transition duration-200"
