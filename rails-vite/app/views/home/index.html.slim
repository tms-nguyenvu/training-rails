section.relative.bg-cover.bg-center.bg-no-repeat.py-32[style="background-image: url('https://preview.colorlib.com/theme/readit/images/bg_1.jpg.webp');"]
  .absolute.inset-0.opacity-80.z-0[style="background: linear-gradient(45deg, #A49CDB 0%, #4D80F0 100%);"]
  .relative.container.mx-auto.text-center.text-white.z-10
    h1.text-6xl.font-extrabold.mb-6.leading-tight.tracking-tight Welcome to My Blog
    p.text-2xl.mb-10.max-w-2xl.mx-auto.leading-relaxed A place to share knowledge, stories, and insights with the world.
    = link_to "#posts", class: "inline-block bg-white text-indigo-600 hover:bg-indigo-100 font-semibold py-3 px-8 rounded-full shadow transition duration-300" do
      | 🚀 Explore Posts


section#posts.container.mx-auto.max-w-7xl.py-20
  h2.text-4xl.font-semibold.text-center.text-gray-800.mb-12 Latest Blog Posts
  .grid.grid-cols-1.sm:grid-cols-2.lg:grid-cols-3.xl:grid-cols-4.gap-10
    - @posts.each do |post|
      .bg-white.border.rounded-xl.shadow-md.overflow-hidden.transition-transform.cursor-pointer.duration-300.hover:-translate-y-1
        - if post.images.attached?
          = image_tag rails_blob_url(post.images.first, only_path: true), alt: post.title, class: "w-full h-64 object-cover"
        - else
          .w-full.h-64.bg-gray-200.flex.items-center.justify-center
            p.text-gray-500.text-xl No Image Available
        .p-6
          h3.text-2xl.font-bold.text-gray-800.mb-3
            = link_to post.title, post_path(post), class: "text-indigo-600 hover:text-indigo-800 transition"
          div[style= "display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis;"]
            = post.content.html_safe
          = link_to "Read More →", post_path(post), class: "text-indigo-500 hover:text-indigo-700 font-medium text-sm"

section.bg-gradient-to-br.from-indigo-100.to-indigo-200.py-20
  .container.mx-auto.text-center
    h2.text-3xl.font-semibold.text-gray-800.mb-6 Join the Community
    p.text-xl.text-gray-700.mb-8 Sign up for our newsletter and get the latest posts delivered to your inbox!
    = link_to "#subscribe", class: "bg-indigo-600 text-white hover:bg-indigo-700 py-3 px-8 rounded-full shadow transition duration-300" do
      | ✉️ Subscribe Now
