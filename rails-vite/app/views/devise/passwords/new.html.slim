section.container.mx-auto.my-20.max-w-md.bg-white.shadow-lg.rounded-lg.p-6
  h2.text-2xl.font-bold.text-center.text-gray-800.mb-6
    | Forgot your password?

  = form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }, class: "space-y-4") do |f|
    = render "devise/shared/error_messages", resource: resource

    .field
      = f.label :email, class: "block text-sm font-medium text-gray-700"
      = f.email_field :email, autofocus: true, autocomplete: "email", class: "mt-1 block w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-indigo-500 focus:border-indigo-500 shadow-sm"

    .actions.mt-6
      = f.submit "Send me reset password instructions", class: "w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2 px-4 rounded-lg shadow-md transition duration-200"

  .flex.justify-between.text-center.mt-4
    = render "devise/shared/links"
